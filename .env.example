# Stream proxy — comma-separated list of allowed upstream domains
# Leave empty to allow all non-private domains (less secure)
STREAM_ALLOWED_DOMAINS=westreamf1.com

# Cloudflare Worker stream proxy URL (offloads video bandwidth from Vercel)
# Deploy the worker in cf-stream-proxy/ and set this to your worker URL
# Example: https://parcferme-stream-proxy.<your-subdomain>.workers.dev
NEXT_PUBLIC_STREAM_PROXY_URL=https://parcferme-stream-proxy.himanshuvenu14.workers.dev
